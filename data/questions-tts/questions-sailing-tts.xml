<?xml version='1.0' encoding='utf-8'?>
<tts-batch xmlns:ns0="http://www.w3.org/2001/10/synthesis">
  <question number="254">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят четыре.</ns0:s>
          <ns0:s>Что понимается под «скуловым килем» (Kimmkieler)?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Яхта с двумя боковыми (скуловыми) килями.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertvierundfünfzig.</ns0:s>
          <ns0:s>Was wird unter einem "Kimmkieler" verstanden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Eine Yacht mit zwei Seitenkielen.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="255">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят пять.</ns0:s>
          <ns0:s>В чём преимущество яхты со скуловыми килями перед другими килевыми яхтами?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Она может без проблем стоять на грунте в вертикальном положении при отливе.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertfünfundfünfzig.</ns0:s>
          <ns0:s>Worin besteht der Vorteil eines Kimmkielers gegenüber anderen Kielbooten?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Er kann problemlos aufrecht trocken fallen.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="256">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят шесть.</ns0:s>
          <ns0:s>Что понимается под «килешвертботом» (Kielschwertyacht)?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Яхта с неглубоким балластным килем и дополнительным подъёмным швертом.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsechsundfünfzig.</ns0:s>
          <ns0:s>Was wird unter einer "Kielschwertyacht" verstanden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Eine Yacht mit flach gehendem Ballastkiel und zusätzlichem aufholbarem Schwert.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="257">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят семь.</ns0:s>
          <ns0:s>Каким образом действуют донные шпигаты швертбота, расположенные ниже ватерлинии?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>За счёт разрежения, возникающего при движении судна через воду.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsiebenundfünfzig.</ns0:s>
          <ns0:s>Wodurch wirken die Bodenlenzventile einer Jolle, die unterhalb der Wasserlinie liegen?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Durch den Sog, der bei Fahrt durchs Wasser entsteht.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="258">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят восемь.</ns0:s>
          <ns0:s>Что понимается под «остойчивостью формы»?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Способность судна противодействовать крену за счёт формы корпуса.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertachtundfünfzig.</ns0:s>
          <ns0:s>Was wird unter "Formstabilität" verstanden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Die Fähigkeit eines Schiffes, durch seine Rumpfform der Krängung entgegenzuwirken.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="259">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести пятьдесят девять.</ns0:s>
          <ns0:s>Что понимается под «весовой остойчивостью»?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Способность судна противодействовать крену за счёт низко расположенного балласта.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertneunundfünfzig.</ns0:s>
          <ns0:s>Was wird unter "Gewichtsstabilität" verstanden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Die Fähigkeit eines Schiffes, durch seinen tief liegenden Ballast der Krängung entgegenzuwirken.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="260">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят.</ns0:s>
          <ns0:s>Какие суда обладают преимущественно «весовой остойчивостью»?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Килевые яхты обладают преимущественно весовой остойчивостью.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsechzig.</ns0:s>
          <ns0:s>Welche Boote sind vorwiegend "gewichtsstabil"?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Kielyachten sind vorwiegend "gewichtsstabil".</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="261">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят один.</ns0:s>
          <ns0:s>Какие суда обладают преимущественно «остойчивостью формы»?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Швертботы обладают преимущественно остойчивостью формы.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihunderteinundsechzig.</ns0:s>
          <ns0:s>Welche Boote sind vorwiegend "formstabil"?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Jollen sind vorwiegend "formstabil".</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="262">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят два.</ns0:s>
          <ns0:s>Каким образом можно повысить остойчивость лодок с остойчивостью формы при сильном ветре?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Откренивание или использование трапеции.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertzweiundsechzig.</ns0:s>
          <ns0:s>Wodurch kann bei formstabilen Booten bei viel Wind die Stabilität erhöht werden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Durch Ausreiten bzw. durch Benutzung der Trapezeinrichtung.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="263">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят три.</ns0:s>
          <ns0:s>Как изменяется восстанавливающий момент швертбота при крене?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Сначала он увеличивается до максимума, затем уменьшается до тех пор, пока центр плавучести и центр тяжести не окажутся на одной вертикали, после чего швертбот опрокидывается.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertdreiundsechzig.</ns0:s>
          <ns0:s>Wie verändert sich das aufrichtende Kraftmoment einer Jolle bei Krängung?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Es nimmt anfangs zu bis zu einem Maximum, von da wieder ab, bis Auftriebs- und Gewischtsschwerpunkt übereinander liegen, anschließend kentert die Jolle.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="264">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят четыре.</ns0:s>
          <ns0:s>Как изменяется восстанавливающий момент килевой яхты при постоянно увеличивающемся крене?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Он увеличивается и после превышения максимума достигает критического угла лишь при более чем 90°.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertvierundsechzig.</ns0:s>
          <ns0:s>Wie verändert sich das aufrichtende Kraftmoment einer Kielyacht bei stetig zunehmender Krängung?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Es nimmt zu und erreicht nach Überschreitung des Maximums seinen kritischen Winkel erst bei über 90°.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="265">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят пять.</ns0:s>
          <ns0:s>Какие меры следует принять при поломке руля на швертботе?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Использовать аварийный руль или весло в качестве замены, покинуть фарватер, обозначить себя как маневронеспособное судно.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertfünfundsechzig.</ns0:s>
          <ns0:s>Welche Maßnahme ist bei Ruderbruch auf einer Jolle zu treffen?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Notruder oder Paddel als Ersatz nehmen, Fahrwasser verlassen, sich als manövrierunfähig zu erkennen geben.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="266">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят шесть.</ns0:s>
          <ns0:s>Каким образом можно обеспечить безопасный доступ к румпелю и управление им даже при крене лодки?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>С помощью удлинителя румпеля.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsechsundsechzig.</ns0:s>
          <ns0:s>Wodurch kann eine Pinnensteuerung auch bei Krängung des Bootes sicher erreicht und bedient werden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Durch einen Pinnenausleger.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="267">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят семь.</ns0:s>
          <ns0:s>Почему тросы на борту следует всегда аккуратно укладывать в бухту?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Чтобы они были готовы к немедленному использованию.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsiebenundsechzig.</ns0:s>
          <ns0:s>Warum sollte Tauwerk an Bord stets ordentlich aufgeschossen werden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Damit es im Gebrauchsfall klar liegt.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="268">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят восемь.</ns0:s>
          <ns0:s>Почему фалы следует всегда аккуратно укладывать в бухту?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Чтобы их можно было быстро и безопасно потравить при необходимости.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertachtundsechzig.</ns0:s>
          <ns0:s>Warum sollten Fallen stets ordentlich aufgeschossen werden?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Damit sie im Gebrauchsfall schnell und sicher gefiert werden können.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="269">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести шестьдесят девять.</ns0:s>
          <ns0:s>Как называются углы паруса?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Фаловый угол, галсовый угол, шкотовый угол.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertneunundsechzig.</ns0:s>
          <ns0:s>Wie heißen die Ecken eines Segels?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
          <ns0:s>Kopf, Hals, Schothorn.</ns0:s>
        </ns0:p>
      </ns0:voice>
    </ns0:speak>
  </question>
  <question number="270">
    <ns0:speak version="1.0" xml:lang="ru-RU">
      <ns0:voice name="ru-RU-DmitryNeural" xml:lang="ru-RU">
        <ns0:p>
          <ns0:s>Вопрос номер двести семьдесят.</ns0:s>
          <ns0:s>Как называются кромки паруса?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Правильный ответ.</ns0:s>
          <ns0:s>Передняя шкаторина, нижняя шкаторина, задняя шкаторина.</ns0:s>
        </ns0:p>
      </ns0:voice>
      <ns0:break time="1300ms" />
      <ns0:voice name="de-DE-Florian:DragonHDLatestNeural" xml:lang="de-DE">
        <ns0:p>
          <ns0:s>Frage Nummer zweihundertsiebzig.</ns0:s>
          <ns0:s>Wie heißen die Kanten eines Segels?</ns0:s>
          <ns0:break time="900ms" />
          <ns0:s>Richtige Antwort.</ns0:s>
